{
  "name": "@aigentia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ worker that drives the simulation ticks, the transaction indexer and experiment lifecycle.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsx src/scripts/demo.ts",
    "experiment": "tsx src/scripts/experiment.ts"
  },
  "dependencies": {
    "@aigentia/agent-core": "workspace:*",
    "@aigentia/db": "workspace:*",
    "@aigentia/economy": "workspace:*",
    "@aigentia/game-engine": "workspace:*",
    "@aigentia/protocol": "workspace:*",
    "@aigentia/shared": "workspace:*",
    "@aigentia/xrpl": "workspace:*",
    "bullmq": "^6.3.10",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
